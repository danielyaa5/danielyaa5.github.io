{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/:path(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/Daniel_Yakobian_Resume.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/script.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/analytics.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/blog/blog.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/resume/resume.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/resume/resume.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/motorcycle-rentals/rentals.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/subscribe/", "destination": "/api/subscribe" }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.danielyakobian.com" }],
      "destination": "https://danielyakobian.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "danielyakobian-com.vercel.app" }],
      "destination": "https://danielyakobian.com/:path",
      "permanent": true
    },
    { "source": "/cloud-media-shrinker/privacy.html", "destination": "/cloud-media-shrinker/privacy/", "permanent": true },
    { "source": "/cloud-media-shrinker/demo.mp4", "destination": "/assets/cloud-media-shrinker/demo.mp4", "permanent": true },
    { "source": "/cloud-media-shrinker/icon.svg", "destination": "/assets/cloud-media-shrinker/icon.svg", "permanent": true },
    { "source": "/cloud-media-shrinker/screenshot-:name([a-z-]+).png", "destination": "/assets/cloud-media-shrinker/screenshot-:name.webp", "permanent": true },
    { "source": "/cloud-media-shrinker/demo.gif", "destination": "https://danielyaa5.github.io/cloud-media-shrinker/demo.gif", "permanent": false },
    { "source": "/photo-review/", "destination": "/cloud-media-shrinker/", "permanent": true },
    { "source": "/photo-review/privacy.html", "destination": "/cloud-media-shrinker/privacy/", "permanent": true },
    {
      "source": "/m2",
      "destination": "https://m2.danielyakobian.com/",
      "permanent": false
    },
    {
      "source": "/m2/",
      "destination": "https://m2.danielyakobian.com/",
      "permanent": false
    }
  ]
}
