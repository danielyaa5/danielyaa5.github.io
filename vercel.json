{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "rewrites": [
    { "source": "/api/subscribe/", "destination": "/api/subscribe" }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.danielyakobian.com" }],
      "destination": "https://danielyakobian.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "danielyakobian-com.vercel.app" }],
      "destination": "https://danielyakobian.com/:path",
      "permanent": true
    },
    {
      "source": "/m2",
      "destination": "https://m2.danielyakobian.com/",
      "permanent": false
    },
    {
      "source": "/m2/",
      "destination": "https://m2.danielyakobian.com/",
      "permanent": false
    }
  ]
}
