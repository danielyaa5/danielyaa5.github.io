{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.danielyakobian.com" }],
      "destination": "https://danielyakobian.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "danielyakobian-com.vercel.app" }],
      "destination": "https://danielyakobian.com/:path",
      "permanent": true
    }
  ]
}
